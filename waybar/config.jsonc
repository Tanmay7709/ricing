// -*- mode: jsonc -*-
{
    "output": ["eDP-1"],
    "layer": "top", 
    "position": "left", 
    "height": -1, 
    "width": 8,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": [
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/audio",
        "group/hardware",
        "network",
        "backlight",
        "battery"
    ],
    
    "hyprland/workspaces": {
        "orientation": "vertical", 
        "on-click": "activate",
        "cursor": "pointer",
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四","5": "五",
            "6": "五", "7": "七", "8": "八", "9": "九","10": "十",
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "group/audio": {
        "orientation": "inherit", 
        "drawer": {
            "transition-duration": 500,
            "transition-top-to-bottom": true
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider",
            "pulseaudio#mic"
        ]
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "tooltip-format": "{volume}%",
        "on-double-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute 0 toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "smooth-scrolling-threshold": 1,
        "reverse-scrolling": 1,
        "cursor": "pointer"
    },
    "pulseaudio/slider": {
        "min": 0, 
        "max": 100, 
        "orientation": "vertical",
        "tooltip-format": "{volume}%"
    },
    "pulseaudio#mic": {
        "format": "",
        "format-muted": "",
        // "format-alt": "{volume}%",   
        "on-double-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute 0 toggle",
        "on-scroll-up": "pactl set-source-volume 0 +5%",
        "on-scroll-down": "pactl set-source-volume 0 -5%",
        "reverse-scrolling": 1
      },
    "group/hardware": {
        "orientation": "inherit", 
        "drawer": {
            "transition-duration": 500,
            "children-class": "hardware-modules",
            "transition-top-to-bottom": true
        },
        "modules": [
            "power-profiles-daemon",
            "cpu",
            "memory",
            "temperature"
        ]
    },
    "clock": {
    "format": "{:%H\n%M}",
    "interval": 1,
    "tooltip-format": "{:%A, %B %d, %Y}"
    },
    "cpu": {
        "format": "C|{usage}%"
    },
    "memory": {
        "format": "M|{}%"
    },
    "temperature": {
        "critical-threshold": 70,
        "format": "{temperatureC}°C"
        // "format-icons": ["", "", ""]
    },
    "backlight": {
        "exec": "brightnessctl g",
        "on-scroll-up": "brightnessctl s 5%+",
        "on-scroll-down": "brightnessctl s 5%-",
        "tooltip-format": "{percent}%",

        "device": "intel_backlight",
        "format": "{icon}",
        // "format-alt": "{percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "good": 61,
            "warning": 30,
            "critical": 15
        },
        "interval": 60,
        "format": "{icon}",
        "tooltip-format": "{capacity}%",
        "format-full": "{icon}",
        "format-charging": "󰂄",     // i didnt had the font downloaded 
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""]
        // "format-icons": {
        // "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        // "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        // } i tried these but they were too smol 
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "",
        "format-icons-wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} SignalStrength({signalStrength}%)",
        "format-ethernet": "",
        "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr} ",
        "format-disconnected": "󰤭",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    }

    // "tray": {
    //     "icon-size": 30,
    //     "spacing": 10,
    //     "icons": {
    //       "blueman": "bluetooth",
    //       "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    //     }
    // },
    // "custom/media": {    
    //     "format": "{icon} {text}",
    //     "return-type": "json",
    //     "max-length": 40,
    //     "format-icons": {
    //         "spotify": "",
    //         "default": "🎜"
    //     },
    //     "escape": true,
    //     "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
    //     // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    // }
}
